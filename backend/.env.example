# ---- Seguranca ----
# Gere com: openssl rand -hex 32 (ou qualquer string longa aleatoria)
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ---- Login do painel (Google SSO) ----
# Client ID OAuth 2.0 (tipo "Web") criado no Google Cloud Console.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# E-mails autorizados a acessar o painel (separados por virgula).
ALLOWED_ADMIN_EMAILS=admin1@example.com,admin2@example.com
# Somente dev: habilita /api/auth/dev-login (login sem Google). NUNCA em producao.
DEV_AUTH_BYPASS=true

# ---- Integracao Google Agenda ----
# Painel admin > Agenda > "Conectar Google Agenda": no mesmo OAuth client
# acima, habilite a Google Calendar API no Google Cloud Console e registre o
# redirect URI abaixo. Copie o "Client secret" do client.
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google-calendar/callback

# ---- Geral ----
TIMEZONE=America/Sao_Paulo
DATABASE_URL=sqlite:///./mulherviva.db
CORS_ORIGINS=http://localhost:5173

# ---- Instagram ----
# Token de longa duracao do Instagram (conta Business/Creator)
IG_ACCESS_TOKEN=
IG_AUTO_SYNC=false

# ---- Politicas de agendamento ----
# Valores padrao; tambem editaveis no painel admin (sobrepoem estes em runtime).
MIN_BOOKING_LEAD_HOURS=2
BUFFER_MINUTES=0
CANCELLATION_WINDOW_HOURS=12
MAX_BOOKING_ADVANCE_DAYS=60

# ---- E-mail / notificacoes ----
# Habilita o envio de e-mails (confirmacao, status). Sem isto, nada e enviado.
NOTIFICATIONS_ENABLED=false
# Usado para e-mails de status (ex: cancelamento). Sem SMTP_HOST, esses e-mails
# nao sao enviados.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
# Chave de API do Resend (https://resend.com/api-keys). Usada para enviar o
# e-mail de confirmacao da consulta e o lembrete 24h antes. Sem isto, esses
# dois e-mails nao sao enviados.
RESEND_API_KEY=
EMAIL_FROM=Mulher Viva <no-reply@mulherviva.com.br>
# URL publica do site (usada em links de e-mail)
PUBLIC_BASE_URL=http://localhost:5173
# URL publica da API (usada para resolver imagens relativas em e-mails de marketing)
API_BASE_URL=http://localhost:8000
CLINIC_NAME=Mulher Viva — Dra. Luciana Lopes
CLINIC_ADDRESS=Centro Médico Lúcio Costa
# E-mails da equipe avisados a cada novo pedido de agendamento (separados por
# virgula). Sem isto, usa ALLOWED_ADMIN_EMAILS.
CLINIC_NOTIFICATION_EMAILS=

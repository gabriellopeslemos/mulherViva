# ============================================================
#  Mulher Viva — configuracao do backend
#  Copie para backend/.env e preencha antes de subir em producao.
# ============================================================

# "development" ou "production".
# Em producao a aplicacao SE RECUSA A INICIAR se alguma das configuracoes
# criticas abaixo continuar com valor inseguro. Isso e proposital.
ENVIRONMENT=development

# ---- Seguranca ----
# OBRIGATORIO em producao. Gere com: openssl rand -hex 32
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Login do painel: apenas Google SSO.
# Client ID OAuth 2.0 (tipo "Web") criado no Google Cloud Console.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# E-mails autorizados a acessar o painel (separados por virgula).
ALLOWED_ADMIN_EMAILS=admin1@example.com,admin2@example.com

# ---- Banco de dados ----
# SQLite (padrao) ou PostgreSQL:
#   postgresql+psycopg://usuario:senha@host:5432/mulherviva
DATABASE_URL=sqlite:///./mulherviva.db

# ---- Rede ----
# Dominios do site que podem chamar a API (separados por virgula).
# Em producao precisa ser https e nao pode ser "*".
CORS_ORIGINS=http://localhost:5173
# Host headers aceitos. Vazio = aceita qualquer um (ok atras de um proxy confiavel).
# Ex.: api.mulherviva.com.br,mulherviva.com.br
ALLOWED_HOSTS=

# ---- Fuso horario ----
# Usado em TODA decisao de horario (slots, prazo de cancelamento, lembretes),
# para que o comportamento nunca dependa do relogio do container.
TIMEZONE=America/Sao_Paulo

# ---- Limite de requisicoes (por IP) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
# Vale para login, agendamento, lista de espera e contato.
SENSITIVE_RATE_LIMIT_PER_MINUTE=10
# Ative APENAS se a API estiver atras de um proxy reverso que voce controla
# (nginx, Cloudflare, load balancer). Caso contrario o cliente pode forjar
# o cabecalho X-Forwarded-For e escapar do limite.
TRUST_PROXY_HEADERS=false

# ---- Politicas de agendamento (tambem editaveis no painel admin) ----
MIN_BOOKING_LEAD_HOURS=2
BUFFER_MINUTES=0
CANCELLATION_WINDOW_HOURS=12
MAX_BOOKING_ADVANCE_DAYS=60

# ---- E-mail / notificacoes ----
# Sem isto nenhum e-mail e enviado (confirmacao, lembrete, contato).
NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=Mulher Viva <no-reply@mulherviva.com.br>
# URL publica do site — usada nos links enviados por e-mail.
# Precisa ser https em producao.
PUBLIC_BASE_URL=http://localhost:5173
# Caixa que recebe as mensagens do formulario de contato.
# Vazio = usa o primeiro e-mail de ALLOWED_ADMIN_EMAILS.
CONTACT_EMAIL=

# ---- Instagram (opcional) ----
# Token de longa duracao do Instagram (conta Business/Creator)
IG_ACCESS_TOKEN=
IG_AUTO_SYNC=false

# ---- Dados da clinica ----
CLINIC_NAME=Mulher Viva — Dra. Luciana Lopes
CLINIC_ADDRESS=Centro Médico Lúcio Costa, SGAS 610, Bloco 2, Sala 250 — Brasília/DF

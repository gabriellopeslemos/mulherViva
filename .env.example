# URL base da API do backend (FastAPI)
VITE_API_URL=http://localhost:8000

# Client ID OAuth 2.0 (tipo "Web") criado no Google Cloud Console — deve ser
# o mesmo GOOGLE_CLIENT_ID configurado em backend/.env. Adicione
# http://localhost:5173 (e o dominio de producao) em "Authorized JavaScript
# origins" dessa credencial.
VITE_GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

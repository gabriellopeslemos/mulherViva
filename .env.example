# Variaveis do frontend (Vite).
#
# ATENCAO: tudo com prefixo VITE_ e embutido no bundle e fica VISIVEL para
# qualquer visitante. Nunca coloque segredos aqui — o Client ID do Google e
# publico por design, mas o Client Secret nao deve aparecer em lugar nenhum.

# URL da API.
#   Desenvolvimento: deixe vazio para usar o proxy do Vite (sem CORS).
#   Producao: https://api.seudominio.com.br
VITE_API_URL=http://localhost:8000

# Client ID OAuth 2.0 (tipo "Web") do Google Cloud Console.
# Precisa ser o MESMO valor de GOOGLE_CLIENT_ID no backend.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Apenas em desenvolvimento: destino do proxy /api do Vite.
VITE_DEV_API_PROXY=http://127.0.0.1:8000
